# .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment / secrets
.env
.env.example
*.env.local
*.env.*.local

# Database
*.db
*.sqlite
*.sqlite3

# Secrets / credentials
*.pem
*.pfx
*.p12
*.jks
*.keystore
*.cer
*.crt
*.key
*.der
credentials.txt
pkcs11.cfg

# Java build artifacts
*.class
*.jar
target/

# Archive files
*.zip

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/.env
frontend/.env.local
frontend/build/
frontend/dist/
frontend/.next/

# Logs
*.log

# Downloaded files / sensitive documents
downloads/
Docs/*.pdf
Docs/*.txt
Docs/*.zip

# Test playground temp files
uat-login-test/
API_Testing/*.json
API_Testing/*.cfg
API_Testing/*.zip
API_Testing/*.jar
API_Testing/target/
API_Testing/**/*.class
API_Testing/**/target/
API_Testing/.kiro/

# Temp / debug scripts
check_sig.py
verify_cred_sig.py
verify_with_cryptography.py
dump_java_sign.py
deploy_nginx.sh
update_nginx.sh
update_nginx2.sh
api_audit.md
fix_ay.py
find_urls.py
TestAES.class

# JSON - only test/temp JSON, not package.json or schema
*.json
!frontend/**/*.json
!Docs/PreFillSchemaJSON_V6.5/*.json
!ITD OFFICAL REFERENCE DOCS/AY 2026-27 Offical Schema JSON/ITR-1_2026_Main_V1.1 (1).json
!package.json
